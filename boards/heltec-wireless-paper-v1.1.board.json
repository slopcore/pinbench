          "id": "bw",
          "label": "Bandwidth",
          "kind": "segmented",
          "options": ["125", "250", "500"],
          "value": "250"
        },
        {
          "id": "sf",
          "label": "Spreading factor",
          "kind": "segmented",
          "options": ["7", "9", "11"],
          "value": "11"
        },
        {
          "id": "cr",
          "label": "Coding rate",
          "kind": "segmented",
          "options": ["5", "6", "8"],
          "value": "5"
        },
        {
          "id": "txPower",
          "label": "TX power",
          "kind": "number",
          "value": 22,
          "min": -9,
          "max": 22,
          "step": 1,
          "unit": "dBm"
        }
      ],
      "layout": { "x": 60, "y": 200, "width": 180, "height": 130 }
    },
