          "label": "Flash mode",
          "kind": "segmented",
          "options": ["DIO", "QIO"],
          "value": "DIO"
        },
        {
          "id": "cpuFreq",
          "label": "CPU clock",
          "kind": "segmented",
          "options": ["80", "160", "240"],
          "value": "240"
        }
      ],
      "layout": { "x": 320, "y": 210, "width": 200, "height": 150 }
    },
    {
      "id": "u2",
      "designator": "U2",
      "name": "SX1262 LoRa radio",
      "mpn": "SX1262",
      "category": "radio",
      "firmwareHook": {
        "symbol": "SX1262Radio::begin()",
        "note": "Brings up the SX1262 on its dedicated SPI bus."
      },
      "deviceModel": "semtech.sx1262",
      "deviceOptions": { "dio2RfSwitch": true, "dio3TcxoVoltage": 1.8 },
      "summary": "Sub-GHz LoRa transceiver on its own SPI bus, chip select GPIO8, BUSY GPIO13, DIO1 IRQ GPIO14. No hardware reset line (RADIOLIB_NC).",
      "buses": ["spi-radio"],
      "pins": [
        { "signal": "SCK", "pin": "GPIO9" },
        { "signal": "MOSI", "pin": "GPIO10" },
        { "signal": "MISO", "pin": "GPIO11" },
        { "signal": "NSS", "pin": "GPIO8" },
        { "signal": "BUSY", "pin": "GPIO13" },
        { "signal": "DIO1", "pin": "GPIO14" },
        { "signal": "TX_LED", "pin": "GPIO18" }
