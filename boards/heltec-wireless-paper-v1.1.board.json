          "label": "Rotation",
          "kind": "segmented",
          "options": ["0°", "90°", "180°", "270°"],
          "value": "270°"
        },
        {
          "id": "scale",
          "label": "Panel zoom",
          "kind": "segmented",
          "options": ["1×", "2×", "3×"],
          "value": "2×"
        },
        {
