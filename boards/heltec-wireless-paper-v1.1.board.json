      "id": "u3",
      "designator": "U3",
      "name": "2.13\" e-paper",
      "mpn": "UC8151",
      "category": "display",
      "firmwareHook": {
        "symbol": "EInkDisplay::update()",
        "note": "Full/partial refresh of the UC8151 e-paper panel."
      },
      "deviceModel": "ultrachip.uc8151",
      "deviceOptions": { "busyActiveLow": true },
      "summary": "128×250 monochrome e-ink (heltec-eink-modules LCMEN2R13EFC1) on its own SPI bus, chip select GPIO4, D/C GPIO5, active-low BUSY GPIO7. Pixels latch on DRF (0x12), not as RAM streams.",
