      "id": "u1",
      "designator": "U1",
      "name": "ESP32-S3",
      "mpn": "ESP32-S3-WROOM-1-N8",
      "category": "mcu",
      "deviceModel": "esp32s3.soc",
      "summary": "Dual-core Xtensa LX7, 8 MB flash, no PSRAM. Two SPI buses: the SX1262 and the e-ink panel do not share one.",
      "buses": ["spi-radio", "spi-disp", "uart0"],
      "pins": [],
      "config": [
        {
          "id": "psram",
          "label": "PSRAM",
          "kind": "segmented",
          "options": ["Off", "2 MB", "8 MB"],
          "value": "Off"
