    {
      "id": "u2",
      "designator": "U2",
      "name": "Ethernet controller",
      "mpn": "W5500",
      "category": "interface",
      "deviceModel": "wiznet.w5500",
      "firmwareHook": {
        "symbol": "Ethernet.begin() / ETH.begin(ETH_PHY_W5500, …)",
        "note": "WIZnet hardwired TCP/IP over SPI: CS GPIO14, INT GPIO10 (active-low), RST GPIO9. Use a GPIO chip-select (SPIClass + digitalWrite), which is what the Arduino Ethernet library and arduino-esp32's SPIClass ETH path do."
      },
      "summary": "10/100 Ethernet MAC+PHY with 8 hardware sockets and 32 KB of buffer, on its own SPI bus (SCK 13, MOSI 11, MISO 12). Emulated at register level: TCP and UDP sockets are bridged to the host's network (DHCP is answered locally), MACRAW frames to QEMU's user-mode network.",
      "buses": [
        "spi-eth"
      ],
      "pins": [
        {
          "signal": "SCK",
          "pin": "GPIO13"
        },
